# Mentoro - Environment Variables
# Copy this file to .env.local for local development

# Backend API base URL.
# Local development defaults to http://localhost:5000/api when this is unset.
# Production defaults to /api when this is unset. On Vercel, set this to your
# deployed backend URL if your API is hosted separately.
VITE_API_BASE_URL=http://localhost:5000/api
